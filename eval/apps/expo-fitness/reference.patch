diff --git a/src/analytics/whisperr.ts b/src/analytics/whisperr.ts
new file mode 100644
index 0000000..1ef673e
--- /dev/null
+++ b/src/analytics/whisperr.ts
@@ -0,0 +1,22 @@
+import AsyncStorage from '@react-native-async-storage/async-storage';
+import { Whisperr } from '@whisperr/react-native';
+
+import type { User } from '../api/types';
+
+const apiKey = process.env.EXPO_PUBLIC_WHISPERR_KEY ?? '';
+
+/** The app's one Whisperr client. `Whisperr.init` is an idempotent singleton. */
+export const whisperr = Whisperr.init({
+  apiKey,
+  baseUrl: process.env.EXPO_PUBLIC_WHISPERR_BASE_URL || undefined,
+  storage: AsyncStorage,
+  disabled: !apiKey,
+});
+
+/** Tell Whisperr who is signed in. Email is a contact channel only when the user opted in. */
+export function identifyUser(user: User) {
+  whisperr.identify(user.id, {
+    traits: { first_name: user.fullName.trim().split(/\s+/)[0] },
+    channels: user.marketingOptIn ? [{ type: 'email', address: user.email, optedIn: true }] : [],
+  });
+}
