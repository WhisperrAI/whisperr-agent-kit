diff --git a/lib/analytics/whisperr.dart b/lib/analytics/whisperr.dart
new file mode 100644
index 0000000..5045f23
--- /dev/null
+++ b/lib/analytics/whisperr.dart
@@ -0,0 +1,33 @@
+import 'dart:async';
+
+import 'package:whisperr/whisperr.dart';
+
+import '../config.dart';
+import '../data/models.dart';
+
+/// Starts the Whisperr SDK once, before the first frame.
+Future<void> initWhisperr() =>
+    Whisperr.initialize(apiKey: AppConfig.whisperrApiKey, baseUrl: AppConfig.whisperrBaseUrl);
+
+/// Records a product event; buffered and delivered in the background.
+void trackEvent(String eventType, Map<String, Object> properties) {
+  if (!Whisperr.isInitialized) return;
+  unawaited(Whisperr.instance.track(eventType, properties: properties));
+}
+
+/// Tells Whisperr who is signed in. Email is a contact channel only with the
+/// learner's marketing consent.
+Future<void> identifyUser(User user) async {
+  if (!Whisperr.isInitialized) return;
+  await Whisperr.instance.identify(
+    user.id,
+    traits: {'first_name': user.firstName},
+    channels: [if (user.marketingOptIn) WhisperrChannel.email(user.email, optedIn: true)],
+  );
+}
+
+/// Forgets the signed-in learner; the next events are anonymous.
+Future<void> resetIdentity() async {
+  if (!Whisperr.isInitialized) return;
+  await Whisperr.instance.reset(flushBeforeReset: false);
+}
